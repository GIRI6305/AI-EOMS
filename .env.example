# Copy this file to .env and fill in real values.
# Never commit the real .env file — .gitignore already excludes it.

# --- Database (TiDB Cloud in production, local MySQL for docker-compose) ---
DB_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/ai_eoms?sslMode=VERIFY_IDENTITY&useSSL=true
DB_USERNAME=your-tidb-username
DB_PASSWORD=your-tidb-password

# --- JWT ---
# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# --- AI (Groq, OpenAI-compatible) ---
OPENAI_API_KEY=your-groq-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=500

# --- Kafka (leave KAFKA_ENABLED=false unless you have a broker running) ---
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=ai-eoms-group
KAFKA_AUTO_OFFSET_RESET=earliest

# --- Server ---
PORT=8080
